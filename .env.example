# Environment Variables for PayTechTN

# Resend API (for email notifications)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Sender email address (must be verified in Resend)
RESEND_FROM_EMAIL=pavithra@paytechtn.com

# Convex deployment URL (automatically set by Convex CLI)
# Format: https://your-deployment.convex.cloud
VITE_CONVEX_URL=https://joyous-goldfinch-712.convex.cloud

# IndexNow API Key (for Bing/Yandex indexing)
# Generated UUID - must match the file in /public/{key}.txt
INDEXNOW_KEY=4ecf6bc8-7e51-4458-a7fa-30c76a79608f

# Note: Never commit this file with real values!
# Copy this to .env.local and fill in your actual credentials
